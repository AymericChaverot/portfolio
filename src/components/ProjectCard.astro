---
import type { Project } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    project: Project;
    lang: Lang;
}

const { project, lang } = Astro.props;

const ACTION_LABELS: Record<string, Record<Lang, string>> = {
    source: { fr: "Voir le code", en: "View Source" },
    info: { fr: "Plus d'infos", en: "More Info" },
    visit: { fr: "Visiter", en: "Visit" },
};

const ACTION_ICONS: Record<string, string> = {
    source: "code",
    info: "info",
    visit: "launch",
};

// La carte mène toujours vers la fiche détaillée du projet : le lien
// externe éventuel est proposé depuis cette fiche.
const href = `/${lang}/projects/${project.slug}`;
const actionLabel = ACTION_LABELS[project.actionType]?.[lang] ?? "";
const actionIcon = ACTION_ICONS[project.actionType] ?? "arrow_forward";
---

<a
    href={href}
    data-spotlight="true"
    class="bg-surface-dark rounded-lg overflow-hidden border border-neutral-800 hover:border-primary/50 transition-all group flex flex-col h-full no-underline"
>
    <div
        class="h-48 bg-black relative overflow-hidden group-hover:opacity-90 transition-opacity"
    >
        {
            project.image ? (
                <img
                    src={project.image.url}
                    alt={project.imageAlt || project.title}
                    width={project.image.width ?? undefined}
                    height={project.image.height ?? undefined}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover opacity-40 grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500"
                />
            ) : (
                <div class="w-full h-full flex items-center justify-center text-neutral-800">
                    <span class="material-icons" style="font-size: 3rem">
                        terminal
                    </span>
                </div>
            )
        }
        <div
            class="absolute inset-0 bg-gradient-to-t from-surface-dark to-transparent"
        >
        </div>
        {
            project.badge && (
                <div class="absolute top-4 right-4 bg-black/80 backdrop-blur text-xs font-mono px-2 py-1 rounded border border-neutral-700 text-primary">
                    {project.badge}
                </div>
            )
        }
    </div>

    <div class="p-6 flex-1 flex flex-col">
        <h3 class="text-xl font-bold text-white mb-2">{project.title}</h3>
        <p class="text-gray-400 text-sm mb-6 flex-1">{project.description}</p>

        {
            project.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-6">
                    {project.tags.map((tag) => (
                        <span class="px-2 py-1 bg-neutral-900 rounded text-xs text-gray-300 font-mono border border-neutral-800">
                            {tag}
                        </span>
                    ))}
                </div>
            )
        }

        <div
            class="flex items-center justify-between pt-4 border-t border-neutral-800"
        >
            <div
                class="text-primary group-hover:text-white font-medium text-sm flex items-center transition-colors"
            >
                <span class="material-icons text-sm mr-2">{actionIcon}</span>
                {actionLabel}
            </div>
            {
                project.statusText && (
                    <span class="text-gray-600 text-xs font-mono">
                        {project.statusText}
                    </span>
                )
            }
        </div>
    </div>
</a>
