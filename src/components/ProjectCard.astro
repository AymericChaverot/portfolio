---
import type { Project } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    project: Project;
    lang: Lang;
}

const { project, lang } = Astro.props;

const ACTION_LABELS: Record<string, Record<Lang, string>> = {
    source: { fr: "Voir le code", en: "View source" },
    info: { fr: "Plus d'infos", en: "More info" },
    visit: { fr: "Visiter", en: "Visit" },
};

const ACTION_ICONS: Record<string, string> = {
    source: "code",
    info: "info",
    visit: "north_east",
};

// La carte mène toujours vers la fiche détaillée : le lien externe éventuel
// est proposé depuis cette fiche.
const href = `/${lang}/projects/${project.slug}`;
const actionLabel = ACTION_LABELS[project.actionType]?.[lang] ?? "";
const actionIcon = ACTION_ICONS[project.actionType] ?? "arrow_forward";
---

<a href={href} class="project" data-spotlight="true">
    <div class="project-media">
        {
            project.image ? (
                <img
                    src={project.image.url}
                    alt={project.imageAlt || project.title}
                    width={project.image.width ?? undefined}
                    height={project.image.height ?? undefined}
                    loading="lazy"
                    decoding="async"
                    class="project-image"
                />
            ) : (
                <div class="project-placeholder">
                    <span class="material-icons">terminal</span>
                </div>
            )
        }
        <div class="project-fade" aria-hidden="true"></div>
        {project.badge && <span class="project-badge">{project.badge}</span>}
    </div>

    <div class="project-body">
        <h3 class="project-title">{project.title}</h3>
        <p class="project-description">{project.description}</p>

        {
            project.tags.length > 0 && (
                <div class="project-tags">
                    {project.tags.map((tag) => (
                        <span class="project-tag">{tag}</span>
                    ))}
                </div>
            )
        }

        <div class="project-footer">
            <span class="project-action">
                {actionLabel}
                <span class="material-icons project-action-icon">{actionIcon}</span>
            </span>
            {project.statusText && (
                <span class="project-status">{project.statusText}</span>
            )}
        </div>
    </div>
</a>

<style>
    /* Cette carte n'utilise pas la classe `.panel` : son liseré doit être
       peint au-dessus du visuel, qui est opaque et pleine largeur. Un liseré
       de fond (comme celui de `.panel`) resterait visible sous le texte mais
       serait recouvert sur l'image, donnant deux épaisseurs différentes sur
       le même contour. Ici, `::after` en est l'unique source. */
    .project {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        text-decoration: none;
        background: #0a0a0a;
        border-radius: var(--radius-card);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .project::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow:
            inset 0 0 0 1px var(--hairline),
            inset 0 1px 0 0 var(--highlight-top);
        pointer-events: none;
        z-index: 2;
        transition: box-shadow 0.3s ease;
    }

    .project:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 32px rgba(0, 0, 0, 0.45);
    }

    .project:hover::after {
        box-shadow:
            inset 0 0 0 1px rgba(244, 140, 37, 0.28),
            inset 0 1px 0 0 var(--highlight-top);
    }

    /* ── Visuel ── */
    .project-media {
        position: relative;
        height: 11rem;
        background: #000;
        overflow: hidden;
        /* L'arrondi doit être porté par l'élément qui découpe.
           `overflow: hidden` sur la carte ne suffit pas : l'image est
           promue sur sa propre couche par la transition de transform, et
           ressort alors en angles vifs par-dessus les coins arrondis. */
        border-radius: var(--radius-card) var(--radius-card) 0 0;
        isolation: isolate;
    }

    .project-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.45;
        filter: grayscale(1);
        transition:
            opacity 0.5s ease,
            filter 0.5s ease,
            transform 0.6s ease;
    }

    .project:hover .project-image {
        opacity: 0.85;
        filter: grayscale(0);
        transform: scale(1.06);
    }

    .project-placeholder {
        display: grid;
        place-items: center;
        height: 100%;
        color: rgba(255, 255, 255, 0.08);
    }

    .project-placeholder .material-icons {
        font-size: 2.75rem;
    }

    .project-fade {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, #0a0a0a 2%, transparent 65%);
    }

    .project-badge {
        position: absolute;
        top: 0.85rem;
        right: 0.85rem;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--color-primary);
        background: rgba(5, 5, 5, 0.7);
        backdrop-filter: blur(8px);
        box-shadow: inset 0 0 0 1px rgba(244, 140, 37, 0.25);
    }

    /* ── Contenu ── */
    .project-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 1.4rem;
    }

    .project-title {
        font-size: 1.125rem;
        font-weight: 650;
        letter-spacing: -0.015em;
        color: #f5f2ef;
        margin: 0 0 0.5rem;
    }

    .project-description {
        font-size: 0.875rem;
        line-height: 1.65;
        color: rgba(255, 255, 255, 0.42);
        margin: 0 0 1.25rem;
        flex: 1;
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-bottom: 1.25rem;
    }

    .project-tag {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: rgba(255, 255, 255, 0.55);
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        box-shadow: inset 0 0 0 1px var(--hairline);
    }

    .project-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding-top: 1rem;
        box-shadow: inset 0 1px 0 0 var(--hairline);
    }

    .project-action {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-primary);
        transition: gap 0.2s ease;
    }

    .project:hover .project-action {
        gap: 0.6rem;
    }

    .project-action-icon {
        font-size: 0.95rem !important;
    }

    .project-status {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: rgba(255, 255, 255, 0.28);
    }
</style>
