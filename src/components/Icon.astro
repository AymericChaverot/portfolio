/** Alias vers les noms Material Icons pour les intentions courantes. */
const MATERIAL_ALIASES: Record<string, string> = {
    email: "mail",
    mail: "mail",
    link: "link",
    phone: "call",
    resume: "description",
    cv: "description",
};

const key = name.toLowerCase().trim();
const brand = BRANDS[key];
const materialName = MATERIAL_ALIASES[key] ?? name;
---

{
    brand ? (
        <svg
            class={className}
            width={size}
            height={size}
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
        >
            <path d={brand} />
        </svg>
    ) : (
        <span class={`material-icons ${className}`} aria-hidden="true" style={`font-size: ${size}`}>
            {materialName}
        </span>
    )
}
