---
import ExperienceCard from "./ExperienceCard.astro";
import { getTimelineGroups } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

/**
 * Un groupe = une section de la timeline (avec son propre titre).
 * `side` définit de quel côté des cards passe la ligne ("left" | "right").
 * L'ordre, le côté et le contenu viennent de la base : la ligne lumineuse
 * serpente automatiquement d'un côté à l'autre entre les groupes.
 */
const groups = getTimelineGroups(lang);

const delayClass = (index: number) =>
    ["", "reveal-delay-100", "reveal-delay-200", "reveal-delay-300"][
        Math.min(index, 3)
    ];
---

{
    groups.length > 0 && (
        <section
            class="py-24 bg-background-dark relative overflow-hidden"
            id="experience"
        >
            <div class="exp-grid-bg" aria-hidden="true" />

            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="journey" id="journey">
                    <svg class="journey-svg" id="journey-svg" aria-hidden="true">
                        <defs>
                            <linearGradient
                                id="journey-grad"
                                gradientUnits="userSpaceOnUse"
                                x1="0"
                                y1="0"
                                x2="0"
                                y2="1"
                            >
                                <stop offset="0" stop-color="#f48c25" />
                                <stop offset="1" stop-color="rgba(244, 140, 37, 0.5)" />
                            </linearGradient>
                            <filter id="journey-blur">
                                <feGaussianBlur stdDeviation="3" />
                            </filter>
                        </defs>
                        <path class="journey-track" id="journey-track" />
                        <path class="journey-glow" id="journey-glow" />
                        <path class="journey-fill" id="journey-fill" />
                    </svg>
                    <div class="journey-tip" id="journey-tip" aria-hidden="true" />

                    {groups.map((group) => (
                        <div class="journey-group" data-side={group.side}>
                            {(group.eyebrow || group.heading) && (
                                <div class="text-center mb-16 reveal">
                                    {group.eyebrow && (
                                        <h2 class="text-base text-primary font-mono tracking-wide uppercase mb-2">
                                            {group.eyebrow}
                                        </h2>
                                    )}
                                    {group.heading && (
                                        <h3 class="text-3xl font-bold text-white">
                                            {group.heading}
                                        </h3>
                                    )}
                                </div>
                            )}

                            <div class="journey-items">
                                {group.items.map((item, index) => (
                                    <div class:list={["exp-item reveal", delayClass(index)]}>
                                        <ExperienceCard item={item} side={group.side} />
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    )
}

<style>
    /* ── Background grid ── */
    .exp-grid-bg {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(244, 140, 37, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(244, 140, 37, 0.025) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
    }

    /* ── Journey container ── */
    .journey {
        position: relative;
    }

    .journey-group {
        position: relative;
        z-index: 1;
    }

    /* Espace entre deux groupes : c'est là que la ligne traverse d'un côté à l'autre */
    .journey-group + .journey-group {
        margin-top: 7rem;
    }

    .journey-items {
        position: relative;
    }

    .journey-group[data-side="left"] .journey-items {
        padding-left: 1.375rem;
    }

    .journey-group[data-side="right"] .journey-items {
        padding-right: 1.375rem;
    }

    /* ── Snaking line (SVG, path computed in JS) ── */
    .journey-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;
        z-index: 0;
    }

    /* Grey base track */
    .journey-track {
        fill: none;
        stroke: rgba(255, 255, 255, 0.07);
        stroke-width: 2;
    }

    /* Orange fill — drawn via stroke-dashoffset driven by scroll */
    .journey-fill {
        fill: none;
        stroke: url(#journey-grad);
        stroke-width: 2;
        stroke-linecap: round;
        will-change: stroke-dashoffset;
    }

    /* Glow trail — short blurred dash trailing behind the tip */
    .journey-glow {
        fill: none;
        stroke: rgba(244, 140, 37, 0.45);
        stroke-width: 7;
        stroke-linecap: round;
        filter: url(#journey-blur);
        opacity: var(--tip-opacity, 0);
        will-change: stroke-dashoffset, opacity;
    }

    /* Tip glow orb — follows the path via transform */
    .journey-tip {
        position: absolute;
        top: 0;
        left: 0;
        width: 10px;
        height: 10px;
        margin: -5px 0 0 -5px;
        border-radius: 50%;
        background: #f48c25;
        box-shadow:
            0 0 10px 4px rgba(244, 140, 37, 0.85),
            0 0 26px 10px rgba(244, 140, 37, 0.35);
        opacity: var(--tip-opacity, 0);
        pointer-events: none;
        z-index: 0;
        will-change: transform, opacity;
    }

    /* ── Items ── */
    .exp-item {
        margin-bottom: 2.5rem;
    }

    .exp-item:last-child {
        margin-bottom: 0;
    }

    @media (max-width: 640px) {
        .journey-group[data-side="left"] .journey-items {
            padding-left: 1.125rem;
        }

        .journey-group[data-side="right"] .journey-items {
            padding-right: 1.125rem;
        }

        .journey-group + .journey-group {
            margin-top: 5rem;
        }
    }
</style>

<script>
    (function () {
        const section = document.getElementById("experience");
        const journey = document.getElementById("journey");
        const svg = document.getElementById("journey-svg");
        const track = document.getElementById("journey-track");
        const fill = document.getElementById("journey-fill");
        const glow = document.getElementById("journey-glow");
        const tip = document.getElementById("journey-tip");
        const grad = document.getElementById("journey-grad");

        if (
            !section ||
            !journey ||
            !svg ||
            !tip ||
            !grad ||
            !(track instanceof SVGPathElement) ||
            !(fill instanceof SVGPathElement) ||
            !(glow instanceof SVGPathElement)
        )
            return;

        // Alias non-null : le narrowing ci-dessus ne se propage pas dans
        // les fonctions imbriquées, ces const gardent le type affiné.
        const sectionEl = section;
        const journeyEl = journey;
        const svgEl = svg;
        const gradEl = grad;
        const trackEl = track;
        const fillEl = fill;
        const glowEl = glow;
        const tipEl = tip;

        // ── Réglages ────────────────────────────────────────────────
        // Fenêtre de scroll : [START, END] fraction de traversée de la
        // section → [0%, 100%] de la ligne dessinée.
        const START = 0.2;
        const END = 0.7;
        const GLOW_FADE_START = 0.85; // le halo s'estompe en fin de course
        const GLOW_LEN = 60; // longueur de la traînée lumineuse (px)
        const END_INSET = 22; // arrêt de la ligne avant le bas du dernier groupe (px)
        const CORNER_RADIUS = 12; // arrondi des angles droits (px, 0 = angles vifs)

        let totalLength = 0;
        let lastProgress = -1;

        // Position d'un élément relative à `journey`, via la chaîne offsetParent
        // (insensible aux transforms des animations .reveal).
        function offsetTo(el: HTMLElement): { x: number; y: number } {
            let x = 0;
            let y = 0;
            let node: HTMLElement | null = el;
            while (node && node !== journeyEl) {
                x += node.offsetLeft;
                y += node.offsetTop;
                node = node.offsetParent as HTMLElement | null;
            }
            return { x, y };
        }

        function buildPath() {
            const width = journeyEl.offsetWidth;
            const height = journeyEl.offsetHeight;

            // Un segment vertical par groupe : x du centre des dots,
            // du centre du premier dot jusqu'au bas du groupe.
            // groupTop (haut du titre) sert à placer la traversée horizontale
            // dans la bande vide entre deux groupes, sans passer sur le texte.
            const segments: {
                x: number;
                yStart: number;
                yBottom: number;
                groupTop: number;
            }[] = [];

            journeyEl.querySelectorAll(".journey-group").forEach((groupRaw) => {
                if (!(groupRaw instanceof HTMLElement)) return;
                const items = groupRaw.querySelector(".journey-items");
                if (!(items instanceof HTMLElement)) return;
                const firstDot = items.querySelector(".timeline-dot");
                if (!(firstDot instanceof HTMLElement)) return;

                const dotPos = offsetTo(firstDot);
                const itemsPos = offsetTo(items);
                segments.push({
                    x: dotPos.x + firstDot.offsetWidth / 2,
                    yStart: dotPos.y + firstDot.offsetHeight / 2,
                    yBottom: itemsPos.y + items.offsetHeight,
                    groupTop: offsetTo(groupRaw).y,
                });
            });

            if (!segments.length) return;

            let d = `M ${segments[0].x} ${segments[0].yStart}`;
            for (let i = 0; i < segments.length; i++) {
                const seg = segments[i];
                const next = segments[i + 1];
                if (next) {
                    const dir = Math.sign(next.x - seg.x);
                    if (dir === 0) {
                        d += ` L ${seg.x} ${next.yStart}`;
                        continue;
                    }
                    // Traversée à angles droits : descente sous le dernier
                    // item, virage horizontal au milieu de la bande vide
                    // (au-dessus du titre du groupe suivant), puis descente
                    // le long du côté du groupe suivant.
                    const crossY = (seg.yBottom + next.groupTop) / 2;
                    const r = Math.min(
                        CORNER_RADIUS,
                        Math.abs(next.x - seg.x) / 2,
                        Math.max(0, crossY - seg.yBottom),
                    );
                    d += ` L ${seg.x} ${crossY - r}`;
                    d += ` Q ${seg.x} ${crossY} ${seg.x + dir * r} ${crossY}`;
                    d += ` L ${next.x - dir * r} ${crossY}`;
                    d += ` Q ${next.x} ${crossY} ${next.x} ${crossY + r}`;
                    d += ` L ${next.x} ${next.yStart}`;
                } else {
                    d += ` L ${seg.x} ${seg.yBottom - END_INSET}`;
                }
            }

            svgEl.setAttribute("viewBox", `0 0 ${width} ${height}`);
            gradEl.setAttribute("y2", String(height));
            trackEl.setAttribute("d", d);
            fillEl.setAttribute("d", d);
            glowEl.setAttribute("d", d);

            totalLength = fillEl.getTotalLength();
            fillEl.style.strokeDasharray = `${totalLength} ${totalLength}`;
            glowEl.style.strokeDasharray = `${GLOW_LEN} ${totalLength}`;

            lastProgress = -1;
            updateLine();
        }

        function updateLine() {
            if (!totalLength) return;

            const { top, height } = sectionEl.getBoundingClientRect();
            const vh = window.innerHeight;

            const scrolled = (vh - top) / (height + vh);
            const progress = Math.min(
                1,
                Math.max(0, (scrolled - START) / (END - START)),
            );

            if (Math.abs(progress - lastProgress) < 0.001) return;
            lastProgress = progress;

            const drawn = progress * totalLength;
            fillEl.style.strokeDashoffset = String(totalLength - drawn);
            glowEl.style.strokeDashoffset = String(GLOW_LEN - drawn);

            const tipRaw =
                progress < GLOW_FADE_START
                    ? Math.min(1, progress / 0.08)
                    : 1 - (progress - GLOW_FADE_START) / (1 - GLOW_FADE_START);
            const tipOpacity = Math.max(0, Math.min(1, tipRaw)).toFixed(3);

            glowEl.style.setProperty("--tip-opacity", tipOpacity);
            tipEl.style.setProperty("--tip-opacity", tipOpacity);

            const pt = fillEl.getPointAtLength(drawn);
            tipEl.style.transform = `translate(${pt.x}px, ${pt.y}px)`;
        }

        let scrollRaf = 0;
        window.addEventListener(
            "scroll",
            () => {
                cancelAnimationFrame(scrollRaf);
                scrollRaf = requestAnimationFrame(updateLine);
            },
            { passive: true },
        );

        let buildRaf = 0;
        function scheduleBuild() {
            cancelAnimationFrame(buildRaf);
            buildRaf = requestAnimationFrame(buildPath);
        }

        window.addEventListener("resize", scheduleBuild, { passive: true });
        new ResizeObserver(scheduleBuild).observe(journeyEl);

        buildPath();
    })();
</script>
