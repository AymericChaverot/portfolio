---
import ExperienceCard from "./ExperienceCard.astro";
import type { Lang } from "../config";

interface Props {
    lang?: string;
}

interface Experience {
    company: string;
    role: string;
    period: string;
    location: string;
    description: string;
    tags: string[];
    icon?: string;
    current?: boolean;
    logo?: string;
}

interface SectionContent {
    sectionLabel: string;
    sectionTitle: string;
    experiences: Experience[];
}

const { lang = "fr" } = Astro.props;
const currentLang = lang as Lang;

const CONTENT: Record<Lang, SectionContent> = {
    fr: {
        sectionLabel: "Parcours Professionnel",
        sectionTitle: "Expériences",
        experiences: [
            {
                company: "Thales Services Numériques",
                role: "Développeur Java Fullstack — Stage",
                period: "Mars 2026 — Présent",
                location: "Lyon, France",
                description:
                    "Développement d'un middleware Java pour le domaine de la microbiologie, automatisation de l'expertise de certains automates. Utilisation de technologies modernes comme Spring Boot, Angular et H2.",
                tags: ["Java", "Spring Boot", "Angular", "H2", "Maven", "GitLab"],
                icon: "biotech",
                current: true,
                logo: "/logos/thales.png",
            },
            {
                company: "Loc'Nacelle",
                role: "Développeur Java Fullstack — Stage",
                period: "Juin 2023 — Août 2023",
                location: "Tossiat, France",
                description:
                    "Développement d'une application web Java pour la gestion de la maintenance des nacelles. Utilisation de technologies modernes comme Spring Boot, Angular et PostgreSQL.",
                tags: ["Java", "Spring Boot", "Angular", "PostgreSQL", "Git"],
                icon: "forklift",
                current: false,
                logo: "/logos/locnacelle.png",
            },
        ],
    },
    en: {
        sectionLabel: "Professional Journey",
        sectionTitle: "Experience",
        experiences: [
            {
                company: "Thales Services Numériques",
                role: "Software Engineer — Internship",
                period: "March 2026 — Present",
                location: "Lyon, France",
                description:
                    "Development of a Java middleware for the field of microbiology, automation of the expertise of certain analyzers. Use of modern technologies such as Spring Boot, Angular and H2.",
                tags: ["Java", "Spring Boot", "Angular", "H2", "Maven", "GitLab"],
                icon: "biotech",
                current: true,
                logo: "/logos/thales.png",
            },
            {
                company: "Loc'Nacelle",
                role: "Software Engineer — Internship",
                period: "June 2023 — Aug. 2023",
                location: "Tossiat, France",
                description:
                    "Development of a Java web application for the management of nacelle maintenance. Use of modern technologies such as Spring Boot, Angular and PostgreSQL.",
                tags: ["Java", "Spring Boot", "Angular", "PostgreSQL", "Git"],
                icon: "forklift",
                current: false,
                logo: "/logos/locnacelle.png",
            },
        ],
    },
};

const t = CONTENT[currentLang];
---

<section class="py-24 bg-background-dark relative overflow-hidden" id="experience">
    <div class="exp-grid-bg" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
            <h2 class="text-base text-primary font-mono tracking-wide uppercase mb-2">
                {t.sectionLabel}
            </h2>
            <h3 class="text-3xl font-bold text-white">{t.sectionTitle}</h3>
        </div>

        <div class="exp-timeline">
            <div class="timeline-line" id="exp-timeline-line" aria-hidden="true">
                <div class="timeline-line-fill"></div>
                <div class="timeline-line-glow"></div>
            </div>

            {t.experiences.map((exp, index) => (
                <div
                    class={`exp-item reveal reveal-delay-${(index + 1) * 100}`}
                    data-exp-index={index}
                >
                    <ExperienceCard
                        company={exp.company}
                        role={exp.role}
                        period={exp.period}
                        location={exp.location}
                        description={exp.description}
                        tags={exp.tags}
                        icon={exp.icon}
                        current={exp.current}
                        logo={exp.logo}
                    />
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    /* ── Background grid ── */
    .exp-grid-bg {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(244, 140, 37, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(244, 140, 37, 0.025) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
    }

    /* ── Timeline container ── */
    .exp-timeline {
        position: relative;
        padding-left: 1.375rem;
    }

    /* ── Vertical line ── */
    .timeline-line {
        position: absolute;
        left: 2.78rem;
        top: 1.375rem;
        bottom: 1.375rem;
        width: 2px;
        z-index: 0;
        overflow: visible;
        transform: translateX(-50%);
    }

    /* Grey base track */
    .timeline-line::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.07);
        border-radius: 1px;
    }

    /* Orange fill — height driven by JS via --line-progress */
    .timeline-line-fill {
        position: absolute;
        inset: 0 0 auto;
        height: var(--line-progress, 0%);
        background: linear-gradient(to bottom, #f48c25, rgba(244, 140, 37, 0.5));
        border-radius: 1px;
        will-change: height;
    }

    /* Tip glow orb */
    .timeline-line-fill::after {
        content: "";
        position: absolute;
        bottom: -5px;
        left: 50%;
        transform: translateX(-50%);
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #f48c25;
        box-shadow:
            0 0 10px 4px rgba(244, 140, 37, 0.85),
            0 0 26px 10px rgba(244, 140, 37, 0.35);
        opacity: var(--tip-opacity, 0);
        will-change: opacity;
    }

    /* Glow trail — follows the tip upward */
    .timeline-line-glow {
        position: absolute;
        left: -3px;
        right: -3px;
        height: 60px;
        background: linear-gradient(to bottom, transparent, rgba(244, 140, 37, 0.45));
        filter: blur(5px);
        border-radius: 2px;
        opacity: var(--tip-opacity, 0);
        will-change: bottom, opacity;
        transform: scaleY(-1);
        transform-origin: bottom;
    }

    /* ── Experience items ── */
    .exp-item {
        margin-bottom: 2.5rem;
    }

    .exp-item:last-child {
        margin-bottom: 0;
    }
</style>

<script>
    (function () {
        const section = document.getElementById("experience");
        const lineWrap = document.getElementById("exp-timeline-line");
        const fillElRaw = lineWrap?.querySelector(".timeline-line-fill");
        const glowElRaw = lineWrap?.querySelector(".timeline-line-glow");

        if (
            !section ||
            !(fillElRaw instanceof HTMLElement) ||
            !(glowElRaw instanceof HTMLElement)
        ) return;

        const sectionEl = section;
        const fillEl = fillElRaw;
        const glowEl = glowElRaw;

        // Scroll window: [0.3, 0.6] fraction of section height → [0%, 100%] fill
        const START = 0.3;
        const END = 0.6;
        const GLOW_FADE_START = 0.8;

        let rafId = 0;
        let lastProgress = -1;

        function updateLine() {
            const { top, height } = sectionEl.getBoundingClientRect();
            const vh = window.innerHeight;

            const scrolled = (vh - top) / (height + vh);
            const progress = Math.min(1, Math.max(0, (scrolled - START) / (END - START)));

            if (Math.abs(progress - lastProgress) < 0.001) return;
            lastProgress = progress;

            const pct = (progress * 100).toFixed(2) + "%";
            const tipRaw =
                progress < GLOW_FADE_START
                    ? Math.min(1, progress / 0.08)
                    : 1 - (progress - GLOW_FADE_START) / (1 - GLOW_FADE_START);
            const tipOpacity = Math.max(0, Math.min(1, tipRaw)).toFixed(3);

            fillEl.style.setProperty("--line-progress", pct);
            fillEl.style.setProperty("--tip-opacity", tipOpacity);
            glowEl.style.setProperty("--tip-opacity", tipOpacity);
            glowEl.style.bottom = `calc(100% - ${pct})`;
        }

        window.addEventListener("scroll", () => {
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(updateLine);
        }, { passive: true });

        updateLine();
    })();
</script>
