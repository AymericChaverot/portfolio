---
interface Props {
    icon: string;
    title: string;
    description: string;
    skills: string[];
}

const { icon, title, description, skills } = Astro.props;
---

<div class="group h-full flex flex-col p-8 rounded bg-surface-dark border border-neutral-800 hover:border-primary transition-all duration-300 relative overflow-hidden hover:shadow-[0_0_30px_1px_rgba(244,140,37,0.3)]">
    <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/30 transition-all duration-500"></div>
    <div class="w-12 h-12 bg-black rounded flex items-center justify-center border border-neutral-800 mb-6 text-primary shadow-sm shadow-primary/10">
        <span class="material-icons">{icon}</span>
    </div>
    <h4 class="text-xl font-bold text-white mb-3">{title}</h4>
    <p class="text-gray-500 mb-6 text-sm leading-relaxed flex-1">{description}</p>
    <ul class="space-y-3">
        {skills.map((skill) => (
            <li class="flex items-center text-sm text-gray-300 font-mono">
                <span class="w-1.5 h-1.5 bg-primary rounded-full mr-3" />
                {skill}
            </li>
        ))}
    </ul>
</div>
