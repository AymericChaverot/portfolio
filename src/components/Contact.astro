---
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import { getSettings, getSocials } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const settings = getSettings(lang);
const socials = getSocials();

const emailSocial = socials.find(
    (s) => s.icon === "email" || s.url.startsWith("mailto:"),
);
const otherSocials = socials.filter((s) => s !== emailSocial);
---

<section
    class="py-20 bg-surface-darker border-t border-neutral-900"
    id="contact"
>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="bg-black rounded-lg border border-neutral-800 shadow-2xl p-4 sm:p-6 font-mono text-sm md:text-base reveal"
        >
            <!-- Window controls -->
            <div class="flex space-x-2 mb-4">
                <div class="w-3 h-3 rounded-full bg-gray-700"></div>
                <div class="w-3 h-3 rounded-full bg-gray-700"></div>
                <div class="w-3 h-3 rounded-full bg-gray-700"></div>
            </div>

            <!-- Terminal prompt + output -->
            <div class="text-gray-400 mb-2 break-all">
                <span class="text-green-500">{settings.contactUser}</span>:<span
                    class="text-blue-500">~</span
                >$ {settings.contactCommand}
            </div>

            {
                settings.contactLines.length > 0 && (
                    <div class="text-gray-300 mb-6 pl-4 border-l-2 border-neutral-800">
                        {settings.contactLines.map((line, index) => (
                            <p
                                class:list={[
                                    "mb-2",
                                    // La dernière ligne fait office de confirmation
                                    index === settings.contactLines.length - 1 &&
                                        "text-primary",
                                ]}
                            >
                                {line}
                            </p>
                        ))}
                    </div>
                )
            }

            <div class="text-gray-400 mb-2">
                <span class="text-green-500">{settings.contactUser}</span>:<span
                    class="text-blue-500">~</span
                >$
                <span class="animate-blink">█</span>
            </div>

            <!-- Actions -->
            <div
                class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4"
            >
                {
                    emailSocial && (
                        <a
                            class="px-6 py-3 bg-primary text-white rounded font-medium hover:bg-primary/90 transition-all flex items-center gap-2 shadow-lg shadow-primary/20"
                            href={emailSocial.url}
                        >
                            <Icon name={emailSocial.icon} size="1.1em" />
                            {settings.contactSendEmail || emailSocial.name}
                        </a>
                    )
                }

                {
                    otherSocials.length > 0 && (
                        <div class="flex flex-wrap gap-4">
                            {otherSocials.map((social) => (
                                <a
                                    class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"
                                    href={social.url}
                                    target={
                                        social.url.startsWith("http") ? "_blank" : undefined
                                    }
                                    rel={
                                        social.url.startsWith("http")
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    <Icon name={social.icon} size="1.1em" />
                                    {social.name}
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
        </div>

        <Footer lang={lang} />
    </div>
</section>
