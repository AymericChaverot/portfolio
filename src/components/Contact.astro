---
import Footer from "./Footer.astro";
import { SITE_CONFIG, type Lang } from "../config";

interface Props {
    lang?: string;
}

const { lang = "fr" } = Astro.props;
const currentLang = lang as Lang;

const CONTACT_USER = "guest@aymeric";

const TERMINAL_LINES: Record<Lang, string[]> = {
    en: [
        '<p class="mb-2">Initializing handshake protocol...</p>',
        '<p class="mb-2 text-primary">Connection established.</p>',
    ],
    fr: [
        '<p class="mb-2">Initialisation du protocole de handshake...</p>',
        '<p class="mb-2 text-primary">Connexion établie.</p>',
    ],
};

const lines = TERMINAL_LINES[currentLang];
const emailSocial = SITE_CONFIG.socials.find((s) => s.name === "Email");
const otherSocials = SITE_CONFIG.socials.filter((s) => s.name !== "Email");
---

<section class="py-20 bg-surface-darker border-t border-neutral-900" id="contact">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-black rounded-lg border border-neutral-800 shadow-2xl p-6 font-mono text-sm md:text-base reveal">
            <!-- Window controls -->
            <div class="flex space-x-2 mb-4">
                <div class="w-3 h-3 rounded-full bg-gray-700"></div>
                <div class="w-3 h-3 rounded-full bg-gray-700"></div>
                <div class="w-3 h-3 rounded-full bg-gray-700"></div>
            </div>

            <!-- Terminal prompt + output -->
            <div class="text-gray-400 mb-2">
                <span class="text-green-500">{CONTACT_USER}</span>:<span class="text-blue-500">~</span>$ ./contact_me.sh
            </div>
            <div class="text-gray-300 mb-6 pl-4 border-l-2 border-neutral-800">
                {lines.map((line) => <Fragment set:html={line} />)}
            </div>
            <div class="text-gray-400 mb-2">
                <span class="text-green-500">{CONTACT_USER}</span>:<span class="text-blue-500">~</span>$
                <span class="animate-blink">█</span>
            </div>

            <!-- Actions -->
            <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
                {emailSocial && (
                    <a
                        class="px-6 py-3 bg-primary text-white rounded font-medium hover:bg-primary/90 transition-all flex items-center shadow-lg shadow-primary/20"
                        href={emailSocial.url}
                    >
                        <span class="material-icons mr-2 text-sm">{emailSocial.icon}</span>
                        {SITE_CONFIG[currentLang].contact.sendEmail}
                    </a>
                )}
                <div class="flex gap-4">
                    {otherSocials.map((social) => (
                        <a
                            class="text-gray-400 hover:text-white transition-colors flex items-center"
                            href={social.url}
                        >
                            <span class="material-icons mr-1 text-sm">{social.icon}</span>
                            {social.name}
                        </a>
                    ))}
                </div>
            </div>
        </div>
        <Footer />
    </div>
</section>
