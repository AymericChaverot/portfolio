---
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import { getSection, getSettings, getSocials } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const settings = getSettings(lang);
const socials = getSocials();
const section = getSection(lang, "contact");

const emailSocial = socials.find(
    (s) => s.icon === "email" || s.url.startsWith("mailto:"),
);
const otherSocials = socials.filter((s) => s !== emailSocial);

/** Adresse lisible, sans le préfixe mailto:. */
const emailAddress = emailSocial?.url.replace(/^mailto:/i, "") ?? "";

/** Identifiant affiché sous le nom du réseau : /AymericChaverot, etc. */
function handleOf(url: string): string {
    try {
        const parsed = new URL(url);
        const path = parsed.pathname.replace(/\/+$/, "");
        return path && path !== "/" ? path : parsed.hostname.replace(/^www\./, "");
    } catch {
        return url.replace(/^https?:\/\/(www\.)?/, "");
    }
}

const t = {
    fr: {
        eyebrow: "Contact",
        heading: "Parlons de votre projet",
        subheading:
            "Une question, une opportunité, ou simplement l'envie d'échanger sur un sujet technique ? Ma boîte est ouverte.",
        emailLabel: "Écrivez-moi",
        elsewhere: "Ailleurs",
        available: "Disponible",
        unavailable: "En poste",
    },
    en: {
        eyebrow: "Contact",
        heading: "Let's talk about your project",
        subheading:
            "A question, an opportunity, or just the urge to discuss something technical? My inbox is open.",
        emailLabel: "Write to me",
        elsewhere: "Elsewhere",
        available: "Available",
        unavailable: "In position",
    },
}[lang];

const heading = section?.heading || t.heading;
const subheading = section?.subheading || t.subheading;
const eyebrow = section?.eyebrow || t.eyebrow;
---

<section class="contact" id="contact">
    <div class="contact-inner">
        <header class="contact-header reveal">
            <p class="section-eyebrow">{eyebrow}</p>
            <h2 class="contact-heading">{heading}</h2>
            <p class="contact-subheading">{subheading}</p>
        </header>

        {
            emailSocial && (
                <a class="contact-mail panel panel-hover reveal reveal-delay-100" href={emailSocial.url}>
                    <span class="contact-mail-icon">
                        <Icon name="email" size="1.35rem" />
                    </span>
                    <span class="contact-mail-body">
                        <span class="contact-mail-label">
                            {settings.contactSendEmail || t.emailLabel}
                        </span>
                        <span class="contact-mail-address">{emailAddress}</span>
                    </span>
                    <span class="material-icons contact-mail-arrow">arrow_forward</span>
                </a>
            )
        }

        {
            otherSocials.length > 0 && (
                <div class="contact-grid reveal reveal-delay-200">
                    {otherSocials.map((social) => (
                        <a
                            class="contact-card panel panel-hover"
                            href={social.url}
                            target={social.url.startsWith("http") ? "_blank" : undefined}
                            rel={
                                social.url.startsWith("http")
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                        >
                            <span class="contact-card-icon">
                                <Icon name={social.icon} size="1.15rem" />
                            </span>
                            <span class="contact-card-body">
                                <span class="contact-card-name">{social.name}</span>
                                <span class="contact-card-handle">
                                    {handleOf(social.url)}
                                </span>
                            </span>
                            <span class="material-icons contact-card-arrow">
                                north_east
                            </span>
                        </a>
                    ))}
                </div>
            )
        }

        <div class="contact-meta reveal reveal-delay-300">
            {
                settings.location && (
                    <span class="contact-meta-item">
                        <span class="material-icons contact-meta-icon">location_on</span>
                        {settings.location}
                    </span>
                )
            }
            <span class="contact-meta-item">
                <span
                    class:list={[
                        "contact-meta-dot",
                        settings.statusAvailable
                            ? "contact-meta-dot--on"
                            : "contact-meta-dot--off",
                    ]}
                />
                {settings.statusText ||
                    (settings.statusAvailable ? t.available : t.unavailable)}
            </span>
        </div>

        <Footer lang={lang} />
    </div>
</section>

<style>
    .contact {
        padding: 6rem 1.5rem 4rem;
        background: var(--color-surface-darker);
        box-shadow: inset 0 1px 0 0 var(--hairline);
    }

    .contact-inner {
        max-width: 48rem;
        margin: 0 auto;
    }

    /* ── En-tête ── */
    .contact-header {
        margin-bottom: 2.5rem;
    }

    .contact-heading {
        font-size: clamp(1.9rem, 4.5vw, 2.75rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.08;
        color: #f8f5f2;
        margin: 0 0 1rem;
        max-width: 18ch;
    }

    .contact-subheading {
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--color-muted);
        margin: 0;
        max-width: 46ch;
    }

    /* ── Carte e-mail ── */
    .contact-mail {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        padding: 1.35rem 1.5rem;
        margin-bottom: 0.75rem;
        text-decoration: none;
    }

    .contact-mail:hover {
        transform: translateY(-2px);
    }

    .contact-mail-icon {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        flex-shrink: 0;
        border-radius: 0.75rem;
        background: rgba(244, 140, 37, 0.12);
        box-shadow: inset 0 0 0 1px rgba(244, 140, 37, 0.22);
        color: var(--color-primary);
    }

    .contact-mail-body {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .contact-mail-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.35);
        margin-bottom: 0.2rem;
    }

    .contact-mail-address {
        font-size: 1.0625rem;
        font-weight: 600;
        color: #f5f2ef;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .contact-mail-arrow {
        font-size: 1.15rem !important;
        color: var(--color-primary);
        flex-shrink: 0;
        transition: transform 0.25s ease;
    }

    .contact-mail:hover .contact-mail-arrow {
        transform: translateX(4px);
    }

    /* ── Autres liens ── */
    .contact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .contact-card {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 1rem 1.15rem;
        text-decoration: none;
    }

    .contact-card:hover {
        transform: translateY(-2px);
    }

    .contact-card-icon {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        flex-shrink: 0;
        border-radius: 0.6rem;
        box-shadow: inset 0 0 0 1px var(--hairline);
        color: #d8d3cd;
    }

    .contact-card-body {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .contact-card-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: #f0ece8;
    }

    .contact-card-handle {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.32);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .contact-card-arrow {
        font-size: 0.9rem !important;
        color: rgba(255, 255, 255, 0.22);
        flex-shrink: 0;
        transition:
            color 0.25s ease,
            transform 0.25s ease;
    }

    .contact-card:hover .contact-card-arrow {
        color: var(--color-primary);
        transform: translate(2px, -2px);
    }

    /* ── Métadonnées ── */
    .contact-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.5rem;
        padding-top: 1.75rem;
        box-shadow: inset 0 1px 0 0 var(--hairline);
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .contact-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .contact-meta-icon {
        font-size: 0.95rem !important;
        color: rgba(255, 255, 255, 0.28);
    }

    .contact-meta-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
    }

    .contact-meta-dot--on {
        background: #4ade80;
        box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.14);
    }

    /* Rouge quand indisponible : c'est le signal voulu. */
    .contact-meta-dot--off {
        background: #ef4444;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.14);
    }
</style>
