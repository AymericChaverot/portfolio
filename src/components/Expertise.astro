---
import SkillCard from "./SkillCard.astro";
import { getExpertiseCards, getSection } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const section = getSection(lang, "expertise");
const cards = getExpertiseCards(lang);

/** Les classes de délai sont fixes en CSS : au-delà de 3, on réutilise 300ms. */
const delayClass = (index: number) =>
    ["", "reveal-delay-100", "reveal-delay-200", "reveal-delay-300"][
        Math.min(index, 3)
    ];
---

{
    cards.length > 0 && (
        <section
            class="py-24 bg-surface-darker border-y border-neutral-900"
            id="expertise"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                {(section?.eyebrow || section?.heading) && (
                    <div class="text-center mb-16 reveal">
                        {section.eyebrow && (
                            <h2 class="text-base text-primary font-mono tracking-wide uppercase mb-2">
                                {section.eyebrow}
                            </h2>
                        )}
                        {section.heading && (
                            <h3 class="text-3xl font-bold text-white">
                                {section.heading}
                            </h3>
                        )}
                        {section.subheading && (
                            <p class="text-gray-400 max-w-2xl mx-auto mt-4">
                                {section.subheading}
                            </p>
                        )}
                    </div>
                )}

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {cards.map((card, index) => (
                        <div class:list={["reveal h-full", delayClass(index)]}>
                            <SkillCard
                                icon={card.icon}
                                title={card.title}
                                description={card.description}
                                skills={card.skills}
                            />
                        </div>
                    ))}
                </div>
            </div>
        </section>
    )
}
