---
import type { TimelineItem } from "../lib/content";

interface Props {
    item: TimelineItem;
    side?: "left" | "right";
}

const { item, side = "left" } = Astro.props;
---

<article class:list={["exp-card", { "exp-card--right": side === "right" }]}>
    <div class="timeline-dot" aria-hidden="true">
        <span class="material-icons">{item.icon}</span>
    </div>

    <div class="exp-card-inner">
        {
            item.logo && (
                <div class="exp-logo-wrap" aria-hidden="true">
                    <img
                        src={item.logo.url}
                        alt=""
                        class="exp-logo"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            )
        }

        <header class="exp-card-header">
            <div class="exp-meta">
                {
                    item.period && (
                        <div class="exp-period font-mono text-primary text-xs tracking-widest uppercase">
                            {item.period}
                        </div>
                    )
                }
                {
                    item.isCurrent && item.badge && (
                        <span class="exp-badge">
                            <span class="exp-badge-dot" />
                            {item.badge}
                        </span>
                    )
                }
            </div>

            <h3 class="exp-role">{item.role}</h3>

            <div class="exp-company-line">
                <span class="exp-company">{item.company}</span>
                {
                    item.location && (
                        <>
                            <span class="exp-separator" aria-hidden="true">
                                ·
                            </span>
                            <span class="exp-location">
                                <span class="material-icons exp-location-icon">
                                    location_on
                                </span>
                                {item.location}
                            </span>
                        </>
                    )
                }
            </div>
        </header>

        {item.description && <p class="exp-description">{item.description}</p>}

        {
            item.tags.length > 0 && (
                <footer class="exp-tags">
                    {item.tags.map((tag) => (
                        <span class="exp-tag">{tag}</span>
                    ))}
                </footer>
            )
        }
    </div>
</article>

<style>
    .exp-card {
        position: relative;
        display: flex;
        gap: 1.75rem;
        align-items: flex-start;
    }

    /* ── Timeline dot ── */
    .timeline-dot {
        flex-shrink: 0;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: #0a0a0a;
        box-shadow:
            0 0 0 1px rgba(244, 140, 37, 0.35),
            0 0 0 5px #050505,
            0 0 14px rgba(244, 140, 37, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 2;
        transition:
            border-color 0.3s ease,
            box-shadow 0.3s ease;
    }

    .timeline-dot .material-icons {
        font-size: 1.1rem;
        color: #f48c25;
    }

    .exp-card:hover .timeline-dot {
        box-shadow:
            0 0 0 1px rgba(244, 140, 37, 0.85),
            0 0 0 5px #050505,
            0 0 20px rgba(244, 140, 37, 0.4);
    }

    /* ── Company logo ── */
    .exp-logo-wrap {
        position: absolute;
        top: 0;
        right: 0;
        width: 18rem;
        height: 18rem;
        pointer-events: none;
        border-radius: inherit;
        overflow: hidden;
        mask-image: radial-gradient(
            ellipse 100% 100% at 100% 0%,
            black 30%,
            transparent 75%
        );
        -webkit-mask-image: radial-gradient(
            ellipse 100% 100% at 100% 0%,
            black 30%,
            transparent 75%
        );
        opacity: 0.12;
        transition: opacity 0.35s ease;
    }

    .exp-card:hover .exp-logo-wrap {
        opacity: 1;
    }

    .exp-logo {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        width: 11rem;
        height: 11rem;
        object-fit: contain;
        object-position: top right;
        filter: grayscale(1) brightness(1.8);
        transition: filter 0.35s ease;
    }

    .exp-card:hover .exp-logo {
        filter: none;
    }

    /* Logo miroir : en haut à gauche sur les cards côté droit */
    .exp-card--right .exp-logo-wrap {
        right: auto;
        left: 0;
        mask-image: radial-gradient(
            ellipse 100% 100% at 0% 0%,
            black 30%,
            transparent 75%
        );
        -webkit-mask-image: radial-gradient(
            ellipse 100% 100% at 0% 0%,
            black 30%,
            transparent 75%
        );
    }

    .exp-card--right .exp-logo {
        right: auto;
        left: 0.75rem;
        object-position: top left;
    }

    /* ── Card inner ── */
    .exp-card-inner {
        flex: 1;
        min-width: 0;
        background: rgba(10, 10, 10, 0.9);
        box-shadow:
            inset 0 0 0 1px var(--hairline),
            inset 0 1px 0 0 var(--highlight-top);
        border-radius: var(--radius-card);
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        transition:
            border-color 0.3s ease,
            box-shadow 0.3s ease,
            transform 0.3s ease;
    }

    .exp-card-inner::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: linear-gradient(
            135deg,
            rgba(244, 140, 37, 0.04) 0%,
            transparent 60%
        );
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .exp-card:hover .exp-card-inner {
        box-shadow:
            inset 0 0 0 1px rgba(244, 140, 37, 0.28),
            inset 0 1px 0 0 var(--highlight-top),
            0 10px 32px rgba(0, 0, 0, 0.45);
        transform: translateX(4px);
    }

    /* ── Mirrored variant: timeline dot on the right, content mirrored ── */
    .exp-card--right {
        flex-direction: row-reverse;
    }

    .exp-card--right:hover .exp-card-inner {
        transform: translateX(-4px);
    }

    .exp-card--right .exp-card-inner {
        text-align: right;
    }

    .exp-card--right .exp-card-inner::before {
        background: linear-gradient(
            225deg,
            rgba(244, 140, 37, 0.04) 0%,
            transparent 60%
        );
    }

    .exp-card--right .exp-meta,
    .exp-card--right .exp-company-line,
    .exp-card--right .exp-tags {
        justify-content: flex-end;
    }

    .exp-card:hover .exp-card-inner::before {
        opacity: 1;
    }

    /* Le contenu texte passe au-dessus du logo (positionné, donc peint après) */
    .exp-card-header,
    .exp-description,
    .exp-tags {
        position: relative;
        z-index: 1;
    }

    /* ── Header ── */
    .exp-card-header {
        margin-bottom: 0.875rem;
    }

    .exp-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.4rem;
        flex-wrap: wrap;
    }

    .exp-period {
        letter-spacing: 0.1em;
    }

    .exp-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(10, 10, 10, 0.9);
        box-shadow: inset 0 0 0 1px rgba(74, 222, 128, 0.4);
        color: #4ade80;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.2rem 0.55rem;
        border-radius: 9999px;
    }

    .exp-badge-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #25f429;
        animation: pulse-dot 1.8s ease-in-out infinite;
    }

    @keyframes pulse-dot {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
            transform: scale(0.7);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .exp-badge-dot {
            animation: none;
        }
    }

    .exp-role {
        font-size: 1.2rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 0.3rem;
        line-height: 1.3;
    }

    .exp-company-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .exp-company {
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.7);
    }

    .exp-separator {
        color: rgba(255, 255, 255, 0.3);
    }

    .exp-location {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .exp-location-icon {
        font-size: 0.85rem !important;
    }

    /* ── Description ── */
    .exp-description {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.55);
        line-height: 1.7;
        margin: 0 0 1.1rem;
    }

    /* ── Tags ── */
    .exp-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .exp-tag {
        font-size: 0.7rem;
        font-family: var(--font-mono, monospace);
        color: rgba(244, 140, 37, 0.8);
        background: rgba(244, 140, 37, 0.07);
        box-shadow: inset 0 0 0 1px rgba(244, 140, 37, 0.18);
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        letter-spacing: 0.04em;
        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .exp-card:hover .exp-tag {
        background: rgba(244, 140, 37, 0.12);
        color: #f48c25;
    }

    /* ── Mobile ──
       On garde la disposition en ligne : le tracé SVG de la timeline est
       calculé à partir de la position des pastilles, passer en colonne le
       ferait serpenter n'importe comment. On récupère juste de la largeur
       pour le texte en resserrant l'écart et la pastille. */
    @media (max-width: 640px) {
        .exp-card {
            gap: 0.875rem;
        }

        .timeline-dot {
            width: 2.25rem;
            height: 2.25rem;
        }

        .timeline-dot .material-icons {
            font-size: 0.95rem;
        }

        .exp-card-inner {
            padding: 1.125rem;
        }

        .exp-role {
            font-size: 1.05rem;
        }

        /* Le logo en filigrane écrase le texte sur petit écran */
        .exp-logo-wrap {
            display: none;
        }
    }
</style>
