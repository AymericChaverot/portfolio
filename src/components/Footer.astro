---
import { getSettings } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const settings = getSettings(lang);

/** Les textes de pied de page acceptent {year} et {name} depuis l'admin. */
const fill = (template: string) =>
    template
        .replace(/\{year\}/g, String(new Date().getFullYear()))
        .replace(/\{name\}/g, settings.name);

const text = fill(settings.footerText);
const subtext = fill(settings.footerSubtext);
---

{/* Pas de lien vers /admin : l'adresse se retient, inutile de l'exposer. */}
<footer class="mt-12 text-center text-xs font-mono text-white/25">
    {text && <p>{text}</p>}
    {subtext && <p class="mt-2 text-white/15">{subtext}</p>}
</footer>
