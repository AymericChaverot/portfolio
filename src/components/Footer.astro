---
import { getSettings } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const settings = getSettings(lang);

/** Les textes de pied de page acceptent {year} et {name} depuis l'admin. */
const fill = (template: string) =>
    template
        .replace(/\{year\}/g, String(new Date().getFullYear()))
        .replace(/\{name\}/g, settings.name);

const text = fill(settings.footerText);
const subtext = fill(settings.footerSubtext);

const adminLabel = lang === "fr" ? "Administration" : "Admin";
---

<footer class="mt-12 text-center text-gray-600 text-xs font-mono">
    {text && <p>{text}</p>}
    {subtext && <p class="mt-2 opacity-50">{subtext}</p>}
    <p class="mt-3">
        <a
            href="/admin"
            class="opacity-30 hover:opacity-100 hover:text-primary transition-all"
            rel="nofollow">{adminLabel}</a
        >
    </p>
</footer>
