---
import ProjectCard from "./ProjectCard.astro";
import { getFeaturedProjects, getProjects, getSection } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const section = getSection(lang, "projects");
const featured = getFeaturedProjects(lang);
const total = getProjects(lang).length;

// La page d'archive reste utile même quand tous les projets sont mis en
// avant : elle offre le filtrage par technologie.
const showAllLink = total > 0;
const allProjectsUrl = `/${lang}/projects`;
const ctaLabel =
    section?.ctaLabel || (lang === "fr" ? "Tous les projets" : "All projects");

const delayClass = (index: number) =>
    ["", "reveal-delay-100", "reveal-delay-200", "reveal-delay-300"][
        Math.min(index % 3, 3)
    ];
---

{
    featured.length > 0 && (
        <section class="py-24 relative bg-background-dark" id="projects">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 reveal gap-4">
                    <div>
                        {section?.eyebrow && (
                            <h2 class="text-base text-primary font-mono tracking-wide uppercase mb-2">
                                {section.eyebrow}
                            </h2>
                        )}
                        {section?.heading && (
                            <h3 class="text-3xl font-bold text-white mb-4">
                                {section.heading}
                            </h3>
                        )}
                        {section?.subheading && (
                            <p class="text-gray-400 max-w-xl">{section.subheading}</p>
                        )}
                    </div>

                    {showAllLink && (
                        <a
                            class="hidden md:flex items-center text-primary hover:text-white transition-colors font-mono text-sm shrink-0"
                            href={allProjectsUrl}
                        >
                            {ctaLabel}
                            <span class="material-icons text-sm ml-2">arrow_forward</span>
                        </a>
                    )}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {featured.map((project, index) => (
                        <div class:list={["reveal", delayClass(index)]}>
                            <ProjectCard project={project} lang={lang} />
                        </div>
                    ))}
                </div>

                {showAllLink && (
                    <div class="mt-8 md:hidden text-center">
                        <a
                            class="inline-flex items-center text-primary hover:text-white transition-colors font-mono text-sm"
                            href={allProjectsUrl}
                        >
                            {ctaLabel}
                            <span class="material-icons text-sm ml-2">arrow_forward</span>
                        </a>
                    </div>
                )}
            </div>
        </section>
    )
}
