---
import HeroTerrain from "./HeroTerrain.astro";
import HeroFlow from "./HeroFlow.astro";
import HeroGlobe from "./HeroGlobe.astro";
import { getSettings } from "../lib/content";
import { highlightCode } from "../lib/highlight";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const settings = getSettings(lang);

// Le code du terminal est saisi en clair dans l'admin puis coloré ici :
// aucun HTML n'est stocké en base.
const lines =
    settings.heroVisual === "terminal"
        ? highlightCode(settings.heroTerminalCode)
        : [];

/**
 * Visuels animés en canvas, interchangeables au même emplacement.
 * Le type autorise explicitement `undefined` : les variantes « aucun » et
 * « terminal » n'ont pas d'entrée ici.
 */
const CANVAS_VISUALS: Record<string, typeof HeroTerrain | undefined> = {
    terrain: HeroTerrain,
    flow: HeroFlow,
    globe: HeroGlobe,
};

const CanvasVisual = CANVAS_VISUALS[settings.heroVisual];

// Les visuels animés occupent tout le fond de la section : le texte se
// centre par-dessus. Seul le terminal reste une colonne à droite.
const centered = settings.heroVisual !== "terminal" || lines.length === 0;
---

<header
    class:list={["hero", centered && "hero--centered"]}
    id="hero"
>
    <!-- Fonds -->
    <div class="hero-backdrop" aria-hidden="true">
        <div class="hero-grid"></div>
        {
            CanvasVisual && (
                <div class="hero-canvas">
                    <CanvasVisual />
                </div>
            )
        }
        <div class="hero-glow"></div>
        {CanvasVisual && <div class="hero-scrim"></div>}
    </div>

    <div class="hero-inner">
        <div class="hero-copy reveal">
            {
                settings.statusText && (
                    <div class="hero-status">
                        <span
                            class:list={[
                                "hero-status-dot",
                                settings.statusAvailable
                                    ? "hero-status-dot--on"
                                    : "hero-status-dot--off",
                            ]}
                        />
                        {settings.statusText}
                    </div>
                )
            }

            <h1 class="hero-name reveal reveal-delay-100">{settings.name}</h1>

            {
                settings.role && (
                    <p class="hero-role reveal reveal-delay-200">{settings.role}</p>
                )
            }

            {
                settings.description && (
                    <p class="hero-description reveal reveal-delay-300">
                        {settings.description}
                    </p>
                )
            }

            <div class="hero-actions reveal reveal-delay-300">
                {
                    settings.heroCtaPrimary && (
                        <a class="hero-button hero-button--primary" href="#projects">
                            {settings.heroCtaPrimary}
                            <span class="material-icons hero-button-icon">
                                arrow_downward
                            </span>
                        </a>
                    )
                }
                {
                    settings.heroCtaSecondary && (
                        <a class="hero-button hero-button--ghost" href="#contact">
                            {settings.heroCtaSecondary}
                        </a>
                    )
                }
            </div>
        </div>

        {
            settings.heroVisual === "terminal" && lines.length > 0 && (
                <div class="hero-visual reveal reveal-delay-200">
                    <div class="terminal">
                        <div class="terminal-bar">
                            <div class="terminal-dots">
                                <span />
                                <span />
                                <span />
                            </div>
                            <span class="terminal-title">
                                {settings.heroTerminalTitle}
                            </span>
                            <span class="terminal-spacer" />
                        </div>
                        <div class="terminal-body">
                            {lines.map((line) => (
                                <div class="terminal-line">
                                    <span class="terminal-number">{line.number}</span>
                                    <span class="terminal-code">
                                        <Fragment set:html={line.html} />
                                    </span>
                                </div>
                            ))}
                            <div class="terminal-line">
                                <span class="terminal-number" />
                                <span class="text-primary animate-blink">█</span>
                            </div>
                        </div>
                    </div>
                </div>
            )
        }
    </div>
</header>

<style>
    /* ── Structure ── */
    .hero {
        position: relative;
        overflow: hidden;
        background: var(--color-background-dark);
        padding: 10rem 1.5rem 6rem;
    }

    @media (min-width: 1024px) {
        .hero {
            padding: 12rem 2rem 8rem;
        }
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 78rem;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem;
        align-items: center;
    }

    @media (min-width: 1024px) {
        .hero-inner {
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
            gap: 4rem;
        }
    }

    /* Variante sans visuel : une seule colonne, centrée. */
    .hero--centered .hero-inner {
        grid-template-columns: 1fr;
        max-width: 52rem;
        text-align: center;
    }

    .hero--centered .hero-status,
    .hero--centered .hero-actions {
        justify-content: center;
    }

    .hero--centered .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero--centered .hero-name {
        font-size: clamp(3rem, 9vw, 5.5rem);
    }

    /* ── Fonds ── */
    .hero-backdrop {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .hero-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 44px 44px;
        /* La grille s'efface vers le bas pour ne pas heurter la section
           suivante par une ligne franche. */
        mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black, transparent 100%);
        -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black, transparent 100%);
    }

    /* Halo circulaire. Il couvre tout le fond et c'est le dégradé qui le
       place : un élément plus petit débordant du hero serait coupé net par
       l'`overflow: hidden`, laissant un bord franc. */
    .hero-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            circle 26rem at 76% 30%,
            rgba(244, 140, 37, 0.12),
            transparent 70%
        );
    }

    .hero--centered .hero-glow {
        background: radial-gradient(
            circle 30rem at 50% 42%,
            rgba(244, 140, 37, 0.11),
            transparent 70%
        );
    }

    /* Voile de lisibilité : le texte passe au-dessus du visuel animé. */
    .hero-canvas {
        position: absolute;
        inset: 0;
    }

    .hero-scrim {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            circle 34rem at 50% 45%,
            rgba(5, 5, 5, 0.82),
            rgba(5, 5, 5, 0.45) 55%,
            transparent 80%
        );
    }

    /* ── Statut ── */
    .hero-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        box-shadow: inset 0 0 0 1px var(--hairline);
        background: rgba(255, 255, 255, 0.02);
        color: var(--color-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.02em;
        margin-bottom: 1.75rem;
    }

    .hero-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
    }

    .hero-status-dot--on {
        background: #4ade80;
        box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.15);
        animation: status-pulse 2.4s ease-in-out infinite;
    }

    /* Rouge quand indisponible : c'est le signal voulu, pas une couleur
       d'accent. */
    .hero-status-dot--off {
        background: #ef4444;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
        animation: status-pulse 2.4s ease-in-out infinite;
    }

    @keyframes status-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.45; }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-status-dot--on,
        .hero-status-dot--off {
            animation: none;
        }
    }

    /* ── Typographie ── */
    .hero-name {
        font-size: clamp(2.75rem, 7vw, 4.75rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 0.98;
        color: #faf8f6;
        margin: 0 0 1rem;
    }

    .hero-role {
        font-family: var(--font-mono);
        font-size: clamp(1rem, 2vw, 1.4rem);
        font-weight: 400;
        letter-spacing: -0.01em;
        color: var(--color-primary);
        margin: 0 0 1.5rem;
    }

    .hero-description {
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--color-muted);
        max-width: 34rem;
        margin: 0 0 2.25rem;
    }

    /* ── Boutons ── */
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .hero-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 1.5rem;
        border-radius: 999px;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        transition:
            background 0.2s ease,
            box-shadow 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .hero-button:hover {
        transform: translateY(-1px);
    }

    .hero-button--primary {
        background: var(--color-primary);
        color: #fff;
        box-shadow: 0 6px 20px rgba(244, 140, 37, 0.22);
    }

    .hero-button--primary:hover {
        background: #ff9a33;
        box-shadow: 0 10px 28px rgba(244, 140, 37, 0.32);
    }

    .hero-button-icon {
        font-size: 1rem !important;
        opacity: 0.8;
    }

    .hero-button--ghost {
        color: #e8e4df;
        box-shadow: inset 0 0 0 1px var(--hairline-strong);
    }

    .hero-button--ghost:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.04);
        box-shadow: inset 0 0 0 1px rgba(244, 140, 37, 0.4);
    }

    /* ── Terminal (variante conservée) ── */
    .hero-visual {
        min-width: 0;
    }

    .terminal {
        border-radius: var(--radius-card);
        overflow: hidden;
        background: #070707;
        box-shadow:
            inset 0 0 0 1px var(--hairline),
            0 20px 50px rgba(0, 0, 0, 0.5);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        line-height: 1.7;
    }

    .terminal-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 0.9rem;
        background: rgba(255, 255, 255, 0.02);
        box-shadow: inset 0 -1px 0 0 var(--hairline);
    }

    .terminal-dots {
        display: flex;
        gap: 0.4rem;
    }

    .terminal-dots span {
        width: 0.65rem;
        height: 0.65rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
    }

    .terminal-title {
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.35);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 0 0.5rem;
    }

    .terminal-spacer {
        width: 2.5rem;
        flex-shrink: 0;
    }

    .terminal-body {
        padding: 1.25rem 1rem;
        overflow-x: auto;
        color: #cfc9c2;
    }

    .terminal-line {
        display: flex;
    }

    .terminal-number {
        width: 1.75rem;
        flex-shrink: 0;
        text-align: right;
        margin-right: 1rem;
        color: rgba(255, 255, 255, 0.18);
        user-select: none;
    }

    .terminal-code {
        white-space: pre;
    }
</style>
