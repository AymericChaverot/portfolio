---
import { getSettings } from "../lib/content";
import { highlightCode } from "../lib/highlight";
import type { Lang } from "../lib/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const settings = getSettings(lang);

// Le code du terminal est saisi en clair dans l'admin puis coloré ici :
// aucun HTML n'est stocké en base.
const lines = highlightCode(settings.heroTerminalCode);

const projectsAnchor = "#projects";
const contactAnchor = "#contact";
---

<header
    class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-background-dark"
    id="hero"
>
    <!-- Background effects -->
    <div class="absolute inset-0 z-0 opacity-40 pointer-events-none">
        <div
            class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-primary/10 to-transparent"
        >
        </div>
        <div
            class="w-full h-full"
            style="background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px); background-size: 30px 30px;"
        >
        </div>
    </div>

    <div
        class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center"
    >
        <div class="lg:w-1/2 text-left reveal">
            {
                settings.statusText && (
                    <div class="inline-flex items-center px-3 py-1 rounded border border-neutral-800 bg-surface-dark text-gray-400 text-xs font-mono mb-6">
                        <span
                            class:list={[
                                "w-2 h-2 rounded-full mr-2 animate-pulse",
                                settings.statusAvailable ? "bg-green-500" : "bg-red-500",
                            ]}
                        />
                        {settings.statusText}
                    </div>
                )
            }

            <h1
                class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white mb-4 reveal reveal-delay-100"
            >
                {settings.name}
            </h1>

            {
                settings.role && (
                    <h2 class="font-mono text-2xl md:text-3xl text-primary font-light mb-6 reveal reveal-delay-200">
                        {settings.role}
                    </h2>
                )
            }

            {
                settings.description && (
                    <p class="text-lg text-gray-400 mb-8 max-w-lg leading-relaxed reveal reveal-delay-300">
                        {settings.description}
                    </p>
                )
            }

            <div class="flex flex-col sm:flex-row gap-4 reveal reveal-delay-300">
                {
                    settings.heroCtaPrimary && (
                        <a
                            class="inline-flex justify-center items-center px-8 py-3 border border-transparent text-base font-medium rounded bg-primary text-white hover:bg-primary/90 transition-all shadow-lg shadow-primary/20"
                            href={projectsAnchor}
                        >
                            {settings.heroCtaPrimary}
                        </a>
                    )
                }
                {
                    settings.heroCtaSecondary && (
                        <a
                            class="inline-flex justify-center items-center px-8 py-3 border border-neutral-700 text-base font-medium rounded text-gray-300 hover:border-primary hover:text-primary transition-all bg-surface-dark"
                            href={contactAnchor}
                        >
                            {settings.heroCtaSecondary}
                        </a>
                    )
                }
            </div>
        </div>

        {
            lines.length > 0 && (
                <div class="lg:w-1/2 mt-12 lg:mt-0 lg:pl-12 w-full reveal reveal-delay-200">
                    <div class="relative rounded-lg bg-black border border-neutral-800 shadow-2xl overflow-hidden font-mono text-sm leading-relaxed">
                        <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-800 bg-surface-dark">
                            <div class="flex space-x-2">
                                <div class="w-3 h-3 rounded-full bg-red-500/80" />
                                <div class="w-3 h-3 rounded-full bg-yellow-500/80" />
                                <div class="w-3 h-3 rounded-full bg-green-500/80" />
                            </div>
                            <div class="text-xs text-gray-500 truncate px-2">
                                {settings.heroTerminalTitle}
                            </div>
                            <div class="w-8" />
                        </div>

                        <div class="p-4 sm:p-6 text-gray-300 overflow-x-auto bg-black/50">
                            {lines.map((line) => (
                                <div class="flex">
                                    <span class="text-gray-700 select-none mr-4 text-right w-6 shrink-0">
                                        {line.number}
                                    </span>
                                    <span class="whitespace-pre">
                                        <Fragment set:html={line.html} />
                                    </span>
                                </div>
                            ))}
                            <div class="flex mt-2">
                                <span class="text-primary animate-blink">█</span>
                            </div>
                        </div>
                    </div>
                </div>
            )
        }
    </div>
</header>
