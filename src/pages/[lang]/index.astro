---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import Expertise from "../../components/Expertise.astro";
import Experience from "../../components/Experience.astro";
import Projects from "../../components/Projects.astro";
import Contact from "../../components/Contact.astro";
import { getSections, getSettings } from "../../lib/content";
import { isLang, type Lang } from "../../lib/i18n";

export const prerender = false;

const { lang: rawLang } = Astro.params;

// Une langue inconnue dans l'URL doit répondre 404, pas afficher le site
// en langue par défaut sous une URL fantôme (mauvais pour le SEO).
if (!isLang(rawLang)) {
    return Astro.rewrite("/404");
}

const lang = rawLang as Lang;
const settings = getSettings(lang);

/**
 * Les sections sont rendues dans l'ordre défini en admin. Une section
 * masquée disparaît simplement de la liste.
 */
const COMPONENTS = {
    hero: Hero,
    expertise: Expertise,
    experience: Experience,
    projects: Projects,
    contact: Contact,
} as const;

const sections = getSections(lang).filter((s) => s.key in COMPONENTS);
---

<Layout lang={lang} description={settings.seoDescription}>
    <Navbar lang={lang} />
    <main id="main-content">
        {
            sections.map((section) => {
                const Component = COMPONENTS[section.key as keyof typeof COMPONENTS];
                return <Component lang={lang} />;
            })
        }
    </main>
</Layout>
