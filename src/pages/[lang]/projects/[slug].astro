---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Contact from "../../../components/Contact.astro";
import { getProject, getProjects } from "../../../lib/content";
import { isLang, type Lang } from "../../../lib/i18n";

export const prerender = false;

const { lang: rawLang, slug } = Astro.params;

if (!isLang(rawLang) || !slug) {
    return Astro.rewrite("/404");
}

const lang = rawLang as Lang;
const project = getProject(lang, slug);

// Projet inexistant ou masqué depuis l'admin : 404 en bonne et due forme.
if (!project) {
    return Astro.rewrite("/404");
}

const t = {
    fr: {
        back: "Retour aux projets",
        overview: "Aperçu",
        architecture: "Architecture",
        stack: "Stack",
        status: "Statut",
        visit: "Visiter le projet",
        source: "Voir le code",
        others: "Autres projets",
    },
    en: {
        back: "Back to projects",
        overview: "Overview",
        architecture: "Architecture",
        stack: "Stack",
        status: "Status",
        visit: "Visit project",
        source: "View source",
        others: "Other projects",
    },
}[lang];

// Le bouton d'action n'a de sens qu'avec une URL : le type « info » n'en a
// pas et générait auparavant un lien href="undefined".
const actionLabel = project.actionType === "visit" ? t.visit : t.source;
const actionIcon = project.actionType === "visit" ? "launch" : "code";

const others = getProjects(lang)
    .filter((p) => p.slug !== project.slug)
    .slice(0, 3);

// Les sections numérotées s'adaptent au contenu réellement rempli.
const sections = [
    project.fullDescription && { title: t.overview, body: project.fullDescription },
    project.architecture && { title: t.architecture, body: project.architecture },
].filter(Boolean) as { title: string; body: string }[];
---

<Layout
    lang={lang}
    title={project.title}
    description={project.description}
    image={project.image?.url}
>
    <Navbar lang={lang} />

    <main id="main-content" class="pt-32 pb-20">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <a
                href={`/${lang}/projects`}
                class="inline-flex items-center text-primary hover:text-white transition-colors mb-12 font-mono text-sm"
            >
                <span class="material-icons text-sm mr-2">arrow_back</span>
                {t.back}
            </a>

            <div class="reveal">
                {
                    project.image && (
                        <div class="h-64 md:h-96 rounded-xl overflow-hidden mb-12 border border-neutral-800 bg-black">
                            <img
                                src={project.image.url}
                                alt={project.imageAlt || project.title}
                                width={project.image.width ?? undefined}
                                height={project.image.height ?? undefined}
                                class="w-full h-full object-cover"
                                decoding="async"
                            />
                        </div>
                    )
                }

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                    <!-- Colonne latérale -->
                    <aside
                        class="gap-8 flex flex-col bg-surface-dark p-6 rounded-xl border border-neutral-800 h-fit lg:sticky lg:top-28"
                    >
                        <div>
                            <h1 class="text-3xl font-bold text-white uppercase mb-2">
                                {project.title}
                            </h1>
                            {
                                project.badge && (
                                    <div class="flex">
                                        <div class="bg-primary/20 backdrop-blur-md text-primary text-xs font-mono px-3 py-1 rounded border border-primary/30">
                                            {project.badge}
                                        </div>
                                    </div>
                                )
                            }
                        </div>

                        {
                            project.tags.length > 0 && (
                                <div>
                                    <h2 class="text-sm font-bold uppercase tracking-wider mb-4 font-mono text-primary">
                                        {t.stack}
                                    </h2>
                                    <div class="flex flex-wrap gap-2">
                                        {project.tags.map((tag) => (
                                            <span class="px-3 py-1 bg-black rounded text-xs text-gray-300 font-mono border border-neutral-800">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            )
                        }

                        {
                            project.statusText && (
                                <div>
                                    <h2 class="text-sm font-bold uppercase tracking-wider mb-4 font-mono text-primary">
                                        {t.status}
                                    </h2>
                                    <div class="flex items-center text-gray-400 font-mono text-sm">
                                        <span class="w-2 h-2 rounded-full bg-green-500 mr-2 animate-pulse" />
                                        {project.statusText}
                                    </div>
                                </div>
                            )
                        }

                        {
                            project.actionUrl && (
                                <div class="pt-2">
                                    <a
                                        href={project.actionUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="w-full inline-flex justify-center items-center px-6 py-3 bg-primary text-white rounded font-medium hover:bg-primary/90 transition-all shadow-lg shadow-primary/20"
                                    >
                                        <span class="material-icons mr-2 text-sm">
                                            {actionIcon}
                                        </span>
                                        {actionLabel}
                                    </a>
                                </div>
                            )
                        }
                    </aside>

                    <!-- Contenu -->
                    <div class="lg:col-span-2 space-y-12">
                        {
                            sections.map((section, index) => (
                                <section>
                                    <h2 class="text-xl font-bold text-white mb-6 flex items-center">
                                        <span class="text-primary font-mono mr-2">
                                            {String(index + 1).padStart(2, "0")}.
                                        </span>
                                        {section.title}
                                    </h2>
                                    <div class="text-gray-400 leading-relaxed space-y-4 text-lg whitespace-pre-line">
                                        {section.body}
                                    </div>
                                </section>
                            ))
                        }
                    </div>
                </div>

                {
                    others.length > 0 && (
                        <section class="mt-20 pt-12 border-t border-neutral-900">
                            <h2 class="text-xl font-bold text-white mb-6">{t.others}</h2>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                {others.map((other) => (
                                    <a
                                        href={`/${lang}/projects/${other.slug}`}
                                        class="group p-4 rounded-lg bg-surface-dark border border-neutral-800 hover:border-primary/50 transition-colors"
                                    >
                                        <div class="text-white font-bold mb-1 group-hover:text-primary transition-colors">
                                            {other.title}
                                        </div>
                                        <div class="text-gray-500 text-sm line-clamp-2">
                                            {other.description}
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )
                }
            </div>
        </div>
    </main>

    <Contact lang={lang} />
</Layout>
