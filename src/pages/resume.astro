---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../config";

const base = import.meta.env.BASE_URL;
---

<Layout title={`Resume | ${SITE_CONFIG.name}`}>
    <main class="min-h-screen flex items-center justify-center p-8 bg-background-dark text-white">
        <div class="max-w-2xl w-full text-center">
            <h1 class="text-4xl font-bold mb-6">Resume</h1>
            <p class="text-gray-400 mb-8">This page is under construction. Please check back soon or contact me directly.</p>
            <a href={base} class="text-primary hover:text-white transition-colors font-mono">&lt; back_home /&gt;</a>
        </div>
    </main>
</Layout>
