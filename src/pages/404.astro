---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getSettings } from "../lib/content";
import { DEFAULT_LANG, isLang, type Lang } from "../lib/i18n";

export const prerender = false;

// La 404 peut être atteinte depuis n'importe quelle URL : on récupère la
// langue du chemin demandé si elle s'y trouve, sinon celle des réglages.
const segment = Astro.url.pathname.split("/").filter(Boolean)[0];
const lang: Lang = isLang(segment)
    ? segment
    : getSettings(DEFAULT_LANG).defaultLang;

const t = {
    fr: {
        title: "Page introuvable",
        code: "404",
        message:
            "Cette page n'existe pas, ou plus. Le lien est peut-être obsolète.",
        home: "Retour à l'accueil",
        projects: "Voir les projets",
        command: "cd /page-introuvable",
        error: "bash: cd: /page-introuvable: Aucun fichier ou dossier de ce nom",
    },
    en: {
        title: "Page not found",
        code: "404",
        message: "This page doesn't exist, or no longer does. The link may be stale.",
        home: "Back to home",
        projects: "Browse projects",
        command: "cd /page-not-found",
        error: "bash: cd: /page-not-found: No such file or directory",
    },
}[lang];

Astro.response.status = 404;
---

<Layout lang={lang} title={t.title} noindex>
    <Navbar lang={lang} />

    <main
        id="main-content"
        class="min-h-screen flex items-center justify-center px-4 py-32 bg-background-dark relative overflow-hidden"
    >
        <div
            class="absolute inset-0 z-0 opacity-40 pointer-events-none"
            aria-hidden="true"
        >
            <div
                class="w-full h-full"
                style="background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px); background-size: 30px 30px;"
            >
            </div>
        </div>

        <div class="relative z-10 max-w-2xl w-full text-center">
            <p
                class="font-mono text-8xl sm:text-9xl font-bold text-primary/20 mb-2 select-none"
            >
                {t.code}
            </p>
            <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">
                {t.title}
            </h1>
            <p class="text-gray-400 mb-10 max-w-md mx-auto">{t.message}</p>

            <div
                class="bg-black rounded-lg border border-neutral-800 shadow-2xl p-4 sm:p-6 font-mono text-xs sm:text-sm text-left mb-10"
            >
                <div class="flex space-x-2 mb-4">
                    <div class="w-3 h-3 rounded-full bg-gray-700"></div>
                    <div class="w-3 h-3 rounded-full bg-gray-700"></div>
                    <div class="w-3 h-3 rounded-full bg-gray-700"></div>
                </div>
                <div class="text-gray-400 break-all">
                    <span class="text-green-500">guest</span>:<span
                        class="text-blue-500">~</span
                    >$ {t.command}
                </div>
                <div class="text-red-400/80 mt-2 break-all">{t.error}</div>
                <div class="text-gray-400 mt-2">
                    <span class="text-green-500">guest</span>:<span
                        class="text-blue-500">~</span
                    >$ <span class="animate-blink">█</span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    class="inline-flex justify-center items-center px-8 py-3 rounded bg-primary text-white font-medium hover:bg-primary/90 transition-all shadow-lg shadow-primary/20"
                    href={`/${lang}`}
                >
                    {t.home}
                </a>
                <a
                    class="inline-flex justify-center items-center px-8 py-3 rounded border border-neutral-700 text-gray-300 font-medium hover:border-primary hover:text-primary transition-all bg-surface-dark"
                    href={`/${lang}/projects`}
                >
                    {t.projects}
                </a>
            </div>
        </div>
    </main>
</Layout>
