# Copier en `.env` et adapter avant de lancer docker compose.

# URL publique du site. Utilisée pour les balises canoniques, les liens
# hreflang et les aperçus Open Graph : elle doit correspondre exactement au
# domaine servi, protocole inclus.
PUBLIC_SITE_URL=https://aymericchaverot.fr

# Port exposé sur l'hôte par nginx.
HTTP_PORT=8080

# ── Variables lues directement par le serveur (déjà fixées dans l'image) ──
# DATABASE_PATH=/data/portfolio.db
# UPLOADS_DIR=/data/uploads
# TRUST_PROXY=1
